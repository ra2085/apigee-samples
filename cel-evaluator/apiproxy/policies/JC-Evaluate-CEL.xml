<JavaCallout name="JC-Evaluate-CEL">
    <ClassName>com.google.apigee.callouts.CelEvaluator</ClassName>
    <Properties>
        <!-- Bind Apigee variable 'request.header.User-Agent' to CEL variable 'user_agent' -->
        <Property name="input-variables">user_agent:request.header.User-Agent</Property>
        
        <!-- Bind resolved template to CEL variable 'greeting' -->
        <Property name="input-templates">greeting:Hello {request.queryparam.name}</Property>
        
        <!-- CEL Expression to evaluate -->
        <Property name="expression">
            size(user_agent) &gt; 0 &amp;&amp; greeting.startsWith("Hello")
        </Property>
        
        <!-- Output variable for the result (boolean in this case) -->
        <Property name="output-variable">cel_result</Property>
    </Properties>
    <ResourceURL>java://cel-evaluator.jar</ResourceURL>
    <IncludeURL>java://cel-0.6.0.jar</IncludeURL>
    <IncludeURL>java://protobuf-java-3.21.7.jar</IncludeURL>
    <!-- Note: Other dependencies like Guava will be included by Apigee if not shaded, or we upload them individually -->
</JavaCallout>
